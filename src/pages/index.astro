---
import Base from '../layouts/Base.astro';
---

<Base
  title="NetworkScan.AI — Network Security for Small Business"
  description="Door-to-door network security scanning for small businesses. $100 flat fee. We find vulnerabilities, give you plain-English results, and leave — no subscriptions, no upsell."
>

<!-- ═══════════════════════════════════════════════════════════
     NAV
══════════════════════════════════════════════════════════ -->
<header id="navbar">
  <div class="nav-inner">
    <a href="#" class="nav-logo">
      <img src="/networkscan-mark.png" alt="Network Scan" style="height:36px;width:auto;display:block;filter:brightness(0) invert(1);" />
      <span class="logo-wordmark">Network Scan</span>
    </a>
    <nav class="nav-links" aria-label="Main navigation">
      <a href="#how">Services</a>
      <a href="#how">How It Works</a>
      <a href="#stats">Why It Matters</a>
      <a href="/blog">Blog</a>
    </nav>
    <a href="#cta-bottom" class="btn-primary nav-cta">Book a $100 Checkup →</a>
    <button class="hamburger" aria-label="Open menu" aria-expanded="false" onclick="toggleMenu(this)">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobileMenu" role="navigation" aria-label="Mobile navigation">
    <a href="#how" onclick="closeMobileMenu()">Services</a>
    <a href="#how" onclick="closeMobileMenu()">How It Works</a>
    <a href="#stats" onclick="closeMobileMenu()">Why It Matters</a>
    <a href="/blog" onclick="closeMobileMenu()">Blog</a>
    <a href="#cta-bottom" class="btn-primary" onclick="closeMobileMenu()">Book a $100 Checkup →</a>
  </div>
</header>

<main>

<!-- ═══════════════════════════════════════════════════════════
     HERO
══════════════════════════════════════════════════════════ -->
<section id="hero">
  <div class="container">
    <div class="hero-inner">

      <!-- Left: text -->
      <div class="hero-text">
        <div class="hero-eyebrow fade-up">Network Security for Small Business</div>
        <h1 class="hero-h1 fade-up delay-1">$100 Network Health Check for Your Business</h1>
        <p class="hero-sub fade-up delay-2">Most small businesses have at least one critical security vulnerability they have no idea about. We find it. You fix it. Done.</p>
        <div class="hero-cta-group fade-up delay-3">
          <a href="#cta-bottom" class="btn-primary large">Book a $100 Security Checkup →</a>
          <p class="hero-disclaimer">No jargon. No disruption. Plain English results before we leave.</p>
        </div>
      </div>

      <!-- Right: mock report card -->
      <div class="hero-visual fade-up delay-2">
        <div class="report-card">
          <div class="report-header">
            <div class="report-title-block">
              <div class="report-title">Network Security Report</div>
              <div class="report-meta">Generated · Main Street Dental, Phoenix AZ</div>
            </div>
            <div class="report-badge">Complete</div>
          </div>

          <!-- Score -->
          <div class="score-block">
            <svg class="score-dial" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="29" cy="29" r="24" stroke="rgba(255,255,255,.08)" stroke-width="6"/>
              <circle cx="29" cy="29" r="24"
                stroke="#e8a830"
                stroke-width="6"
                stroke-dasharray="150.8"
                stroke-dashoffset="60"
                stroke-linecap="round"
                transform="rotate(-90 29 29)"/>
              <text x="29" y="34" text-anchor="middle" fill="#ffffff" font-size="13" font-weight="700" font-family="Inter,sans-serif">62</text>
            </svg>
            <div class="score-info">
              <div class="score-label">Risk Score</div>
              <div class="score-value">62<span style="font-size:18px;color:rgba(255,255,255,.4)">/100</span></div>
              <div class="score-sub">Moderate — Action recommended</div>
            </div>
          </div>

          <!-- Progress bars -->
          <div class="progress-row">
            <div class="progress-label-row"><span>Scan Coverage</span><span style="color:#e8a830">100%</span></div>
            <div class="progress-bar"><div class="progress-fill" style="width:100%;background:var(--green)"></div></div>
          </div>
          <div class="progress-row">
            <div class="progress-label-row"><span>Devices Analyzed</span><span style="color:rgba(255,255,255,.65)">14 / 14</span></div>
            <div class="progress-bar"><div class="progress-fill" style="width:100%;background:rgba(232,168,48,.6)"></div></div>
          </div>

          <!-- Findings -->
          <div class="findings-label">Findings — 3 Issues Detected</div>

          <div class="finding critical">
            <div class="finding-dot"></div>
            <div class="finding-body">
              <div class="finding-name">Exposed RDP Port (3389)</div>
              <div class="finding-desc">Open to internet · No auth restrictions</div>
            </div>
            <div class="finding-tag">Critical</div>
          </div>

          <div class="finding medium">
            <div class="finding-dot"></div>
            <div class="finding-body">
              <div class="finding-name">Guest WiFi Network Overlap</div>
              <div class="finding-desc">Guest traffic shares POS subnet</div>
            </div>
            <div class="finding-tag">Medium</div>
          </div>

          <div class="finding low">
            <div class="finding-dot"></div>
            <div class="finding-body">
              <div class="finding-name">Firmware Out of Date</div>
              <div class="finding-desc">Router model HR-2040 · 3 versions behind</div>
            </div>
            <div class="finding-tag">Low</div>
          </div>

          <div class="report-footer">
            <div class="report-footer-label">NetworkScan.AI · Confidential</div>
            <div class="report-footer-status">
              <div class="status-dot"></div>
              Report delivered
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     STATS BAR
══════════════════════════════════════════════════════════ -->
<section id="stats">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item fade-up">
        <div class="stat-number">$200,000</div>
        <div class="stat-label">Average cost of an SMB data breach</div>
      </div>
      <div class="stat-item fade-up delay-1">
        <div class="stat-number">43%</div>
        <div class="stat-label">of cyberattacks target small businesses</div>
      </div>
      <div class="stat-item fade-up delay-2">
        <div class="stat-number">$170K</div>
        <div class="stat-label">Average ransomware payment for an SMB</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     HOW IT WORKS
══════════════════════════════════════════════════════════ -->
<section id="how">
  <div class="container">
    <div class="section-header">
      <div class="section-label fade-up">How It Works</div>
      <h2 class="section-h2 fade-up delay-1">Simple. Fast. No disruption.</h2>
      <p class="section-sub fade-up delay-2">Three steps from booking to knowing exactly where you stand.</p>
    </div>
    <div class="steps-grid">

      <div class="step-card fade-up">
        <div class="step-num">1</div>
        <div class="step-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        </div>
        <div class="step-title">Book Your Checkup</div>
        <p class="step-body">Choose a time online or call us. We come to your location — no need to send anything or prepare in advance.</p>
      </div>

      <div class="step-card fade-up delay-1">
        <div class="step-num">2</div>
        <div class="step-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><circle cx="12" cy="20" r="1" fill="var(--amber)" stroke="none"/>
          </svg>
        </div>
        <div class="step-title">We Scan. You Work.</div>
        <p class="step-body">Our 30–45 minute passive scan runs quietly in the background. Your team keeps working normally. We check everything from your public internet exposure to every device on your internal network — without touching a single computer.</p>
      </div>

      <div class="step-card fade-up delay-2">
        <div class="step-num">3</div>
        <div class="step-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/>
          </svg>
        </div>
        <div class="step-title">We Walk You Through It</div>
        <p class="step-body">We walk you through your results before we pack up — plain English, no jargon, no waiting.</p>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     WHAT'S INCLUDED
══════════════════════════════════════════════════════════ -->
<section id="included">
  <div class="container">
    <div class="included-grid">

      <div class="included-left">
        <div class="section-label fade-up">What's Included</div>
        <h2 class="included-h2 fade-up delay-1">Network Health Check<br>— $100 flat</h2>
        <p class="included-p fade-up delay-2">
          One flat fee. One visit. One report you can actually read. No recurring subscription, no upsell pressure, no confusing tech-speak. Just an honest picture of your network's security posture — and what to do next.
        </p>
        <p class="included-p fade-up delay-3" style="margin-top:16px;">
          Every scan is conducted by a certified network security professional using the same passive tools trusted by enterprise security teams — not guesswork software.
        </p>
      </div>

      <div class="fade-up delay-2">
        <div class="checklist-card">
          <div class="check-item">
            <div class="check-icon">
              <svg viewBox="0 0 12 12" fill="none" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg>
            </div>
            <div class="check-text"><strong>Shodan / public IP exposure check</strong> — what the open internet sees about your business before we arrive</div>
          </div>
          <div class="check-item">
            <div class="check-icon">
              <svg viewBox="0 0 12 12" fill="none" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg>
            </div>
            <div class="check-text"><strong>Email breach scan</strong> — every staff email checked against known data breaches</div>
          </div>
          <div class="check-item">
            <div class="check-icon">
              <svg viewBox="0 0 12 12" fill="none" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg>
            </div>
            <div class="check-text"><strong>Email security (DMARC/SPF/DKIM)</strong> — stops attackers from impersonating your domain</div>
          </div>
          <div class="check-item">
            <div class="check-icon">
              <svg viewBox="0 0 12 12" fill="none" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg>
            </div>
            <div class="check-text"><strong>External network scan</strong> — open ports, exposed services, misconfigured access</div>
          </div>
          <div class="check-item">
            <div class="check-icon">
              <svg viewBox="0 0 12 12" fill="none" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg>
            </div>
            <div class="check-text"><strong>Full device inventory</strong> — every device on your network, including ones you forgot about</div>
          </div>
          <div class="check-item">
            <div class="check-icon">
              <svg viewBox="0 0 12 12" fill="none" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg>
            </div>
            <div class="check-text"><strong>Default credential checks</strong> on routers, printers, cameras, and NAS devices</div>
          </div>
          <div class="check-item">
            <div class="check-icon">
              <svg viewBox="0 0 12 12" fill="none" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg>
            </div>
            <div class="check-text"><strong>Known CVE checks</strong> on discoverable services</div>
          </div>
          <div class="check-item">
            <div class="check-icon">
              <svg viewBox="0 0 12 12" fill="none" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg>
            </div>
            <div class="check-text"><strong>SNMP &amp; UPnP exposure</strong> — common router/switch misconfigurations</div>
          </div>
          <div class="check-item">
            <div class="check-icon">
              <svg viewBox="0 0 12 12" fill="none" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg>
            </div>
            <div class="check-text"><strong>SSL/TLS audit</strong> on your public-facing website and mail server</div>
          </div>
          <div class="check-item">
            <div class="check-icon">
              <svg viewBox="0 0 12 12" fill="none" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg>
            </div>
            <div class="check-text"><strong>Wireless network discovery</strong> — rogue APs, WPS vulnerabilities, network segmentation</div>
          </div>
          <div class="check-item">
            <div class="check-icon">
              <svg viewBox="0 0 12 12" fill="none" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg>
            </div>
            <div class="check-text"><strong>Cleartext protocol detection</strong> — catches unencrypted traffic on your own network</div>
          </div>
          <div class="check-item">
            <div class="check-icon">
              <svg viewBox="0 0 12 12" fill="none" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg>
            </div>
            <div class="check-text"><strong>Plain-English written report</strong> with severity rating for every finding</div>
          </div>
          <div class="check-item">
            <div class="check-icon">
              <svg viewBox="0 0 12 12" fill="none" stroke="var(--navy)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1.5 6 4.5 9 10.5 3"/></svg>
            </div>
            <div class="check-text"><strong>Executive summary</strong> you can share with your team or board</div>
          </div>
        </div>
        <div class="included-cta">
          <a href="#cta-bottom" class="btn-primary">Book for $100 →</a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
