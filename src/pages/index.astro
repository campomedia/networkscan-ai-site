<!-- ═══════════════════════════════════════════════════════════
     SAFE BY DESIGN
══════════════════════════════════════════════════════════ -->
<section id="safe">
  <div class="container">
    <div class="section-label fade-up">Our Promise</div>
    <h2 class="safe-h2 fade-up delay-1">Safe by Design</h2>
    <div class="safe-grid">

      <div class="safe-item fade-up">
        <div class="safe-icon">
          <svg viewBox="0 0 26 26" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2L3 7v6c0 5.55 4.08 10.74 10 12 5.92-1.26 10-6.45 10-12V7L13 2z"/>
            <polyline points="9 12 11.5 14.5 17 9"/>
          </svg>
        </div>
        <div class="safe-title">Read-only scan</div>
        <p class="safe-body">We observe — we don't write, change, or touch anything on your network. Our tools are entirely passive and non-intrusive.</p>
      </div>

      <div class="safe-item fade-up delay-1">
        <div class="safe-icon">
          <svg viewBox="0 0 26 26" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="11" width="16" height="12" rx="2"/><path d="M9 11V7a4 4 0 0 1 8 0v4"/>
            <circle cx="13" cy="17" r="1.5" fill="var(--amber)" stroke="none"/>
          </svg>
        </div>
        <div class="safe-title">No access to your data</div>
        <p class="safe-body">We look at your network's security posture — not your files, emails, customer records, or any business materials.</p>
      </div>

      <div class="safe-item fade-up delay-2">
        <div class="safe-icon">
          <svg viewBox="0 0 26 26" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17.94 17.94A10.07 10.07 0 0 1 13 19C7 19 2.73 14 1 13c.78-1.22 2.38-3.25 4.56-4.94"/>
            <path d="M9.9 4.24C10.56 4.08 11.27 4 12 4c6 0 10.27 5 12 6-1.01 1.58-2.82 3.67-5.11 5.1"/>
            <line x1="2" y1="2" x2="24" y2="24"/>
          </svg>
        </div>
        <div class="safe-title">Totally confidential</div>
        <p class="safe-body">Your report is yours alone. We never share, publish, or reference your findings with anyone — ever. We're legally bound to privacy.</p>
      </div>

    </div>
  </div>
</section>

